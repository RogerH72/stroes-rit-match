# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Real values (secret key, hostnames, share paths) belong on the server only.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
RMW_SECRET_KEY=change-me

# 1 only on a development machine.
RMW_DEBUG=0

# Comma-separated hostnames the app may be served under.
RMW_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins, needed when served behind a proxy or a real hostname.
# RMW_CSRF_TRUSTED_ORIGINS=https://rmw.example.local

# SQLite file location (development). No production database chosen yet.
RMW_DB_PATH=/app/data/db.sqlite3

# --- File detection on the server share (roadmap phase 2) ---

# Directory the app watches for the Syntess exports and the RouteVision download.
# On the server this is a mount of the share \\stroes-1909\atrium\Autoprint\RUUDS;
# locally, point it at an ordinary folder holding (copies of) the sample exports.
# RMW_INBOX_DIR is the old name for this and is still accepted.
SERVERMAP_PATH=/app/data/inbox

# How often the scheduler checks the share, in minutes.
POLL_INTERVAL_MINUTES=5

# How long a file's size must stay unchanged before it is read, in minutes.
# Independent of the poll interval: the required number of consecutive unchanged
# measurements is derived from the two (30 / 5 = 6 measurements by default).
STABILITY_MINUTES=30

# DEBUG, INFO, WARNING, ERROR
RMW_LOG_LEVEL=INFO
