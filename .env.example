# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Real values (secret key, hostnames, share paths) belong on the server only.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
RMW_SECRET_KEY=change-me

# 1 only on a development machine.
RMW_DEBUG=0

# Comma-separated hostnames the app may be served under.
RMW_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins, needed when served behind a proxy or a real hostname.
# RMW_CSRF_TRUSTED_ORIGINS=https://rmw.example.local

# SQLite file location (development). No production database chosen yet.
RMW_DB_PATH=/app/data/db.sqlite3

# Directory the app watches for the Syntess exports and the RouteVision download
# (roadmap phase 2). On the server this is a mount of
# \stroes-1909\atrium\Autoprint\RUUDS.
RMW_INBOX_DIR=/app/data/inbox

# DEBUG, INFO, WARNING, ERROR
RMW_LOG_LEVEL=INFO
